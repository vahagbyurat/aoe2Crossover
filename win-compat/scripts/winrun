#!/usr/bin/env bash
# =============================================================================
# winrun — Wine prefix launcher
#
# Usage:
#   winrun <prefix_name> <path_to_exe_or_winecommand> [args...]
#
# Examples:
#   winrun aoe2 notepad
#   winrun aoe2 winecfg
#   winrun aoe2 "/path/to/AoE2DE/AoE2DE_s.exe"
#   winrun aoe2 ~/Downloads/setup.exe /silent
#   winrun myprefix wineboot --init
#
# Prefix auto-creation:
#   If ~/win-compat/prefixes/<prefix_name> does not exist, winrun creates
#   it automatically (Windows 10, 64-bit) before launching the EXE.
#
# Logs:
#   ~/win-compat/logs/<prefix_name>_<timestamp>.log
#
# Environment variables (override before calling winrun):
#   WINE_BIN          – explicit path to wine/wine64 binary
#   WINEDEBUG         – wine debug channels (default: -all)
#   DXVK_LOG_LEVEL    – dxvk logging (default: warn)
#   WINCOMPAT_ROOT    – root directory (default: ~/win-compat)
# =============================================================================

set -eo pipefail
IFS=$'\n\t'

# ── colours ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
info()  { echo -e "${CYAN}[winrun]${RESET} $*"; }
ok()    { echo -e "${GREEN}[winrun]${RESET} $*"; }
warn()  { echo -e "${YELLOW}[winrun]${RESET} $*" >&2; }
die()   { echo -e "${RED}[winrun] FATAL:${RESET} $*" >&2; exit 1; }

# ── arg parsing ─────────────────────────────────────────────────────────────
if [[ $# -lt 2 ]]; then
    echo "Usage: winrun <prefix_name> <exe_or_wine_command> [args...]"
    echo ""
    echo "Examples:"
    echo "  winrun aoe2 notepad"
    echo "  winrun aoe2 winecfg"
    echo "  winrun aoe2 /path/to/game.exe --fullscreen"
    echo "  winrun default ~/Downloads/setup.exe"
    exit 1
fi

PREFIX_NAME="$1"; shift
EXE="$1";         shift
EXTRA_ARGS=("$@")

# ── paths ───────────────────────────────────────────────────────────────────
WINCOMPAT_ROOT="${WINCOMPAT_ROOT:-$HOME/win-compat}"
CONFIG_ENV="$WINCOMPAT_ROOT/config.env"
PREFIX_DIR="$WINCOMPAT_ROOT/prefixes/$PREFIX_NAME"
LOG_DIR="$WINCOMPAT_ROOT/logs"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
LOGFILE="$LOG_DIR/${PREFIX_NAME}_${TIMESTAMP}.log"

mkdir -p "$LOG_DIR"

# ── source config ────────────────────────────────────────────────────────────
if [[ -f "$CONFIG_ENV" ]]; then
    # shellcheck source=../config.env
    source "$CONFIG_ENV"
else
    warn "config.env not found at $CONFIG_ENV – using defaults"
fi

# ── locate Wine binary ───────────────────────────────────────────────────────
_find_wine() {
    # wine-crossover Cask (highest priority on macOS ARM)
    local xover_roots=(
        "/Applications/Wine Crossover.app/Contents/Resources/wine/bin"
        "/Applications/Wine Stable.app/Contents/Resources/wine/bin"
    )
    for root in "${xover_roots[@]}"; do
        for bin in wine64 wine; do
            [[ -x "$root/$bin" ]] && { echo "$root/$bin"; return 0; }
        done
    done
    # Homebrew (arm64 or x86_64 via Rosetta)
    local brew_prefix
    brew_prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
    for bin in wine64 wine; do
        [[ -x "$brew_prefix/bin/$bin" ]] && { echo "$brew_prefix/bin/$bin"; return 0; }
    done
    # Last resort PATH
    command -v wine64 2>/dev/null && return 0
    command -v wine   2>/dev/null && return 0
    echo ""
}

if [[ -z "${WINE_BIN:-}" ]]; then
    WINE_BIN="$(_find_wine)"
fi

[[ -z "$WINE_BIN" ]] && die "No Wine binary found.
  Install via: brew install --cask --no-quarantine wine-crossover
  Or run: ~/win-compat/scripts/setup.sh"

# Verify binary is executable
[[ -x "$WINE_BIN" ]] || die "Wine binary not executable: $WINE_BIN"

# ── architecture check ───────────────────────────────────────────────────────
HOST_ARCH="$(uname -m)"
WINE_BIN_ARCH="$(file "$WINE_BIN" 2>/dev/null | grep -oE 'x86.64|arm64|aarch64' | head -1 || echo unknown)"

info "Host arch  : $HOST_ARCH"
info "Wine arch  : $WINE_BIN_ARCH"
info "Wine bin   : $WINE_BIN"

if [[ "$HOST_ARCH" == "arm64" && "$WINE_BIN_ARCH" == "x86_64" ]]; then
    # Confirm Rosetta 2 is present
    if ! /usr/bin/pgrep -q oahd 2>/dev/null && \
       ! [[ -f /Library/Apple/usr/share/rosetta/rosetta ]]; then
        warn "Rosetta 2 does not appear to be installed."
        warn "Wine (x86_64) REQUIRES Rosetta 2 on Apple Silicon."
        warn "Install it with: softwareupdate --install-rosetta --agree-to-license"
        # Don't exit – let the exec fail with a clear OS error
    else
        info "Rosetta 2 present – will translate x86_64 Wine binary transparently"
    fi
fi

# ── Wine version ─────────────────────────────────────────────────────────────
WINE_VER="$("$WINE_BIN" --version 2>/dev/null || echo unknown)"
info "Wine ver   : $WINE_VER"

# ── create / validate prefix ─────────────────────────────────────────────────
if [[ ! -d "$PREFIX_DIR/drive_c" ]]; then
    info "Prefix '$PREFIX_NAME' not found – creating at $PREFIX_DIR …"
    WINEPREFIX="$PREFIX_DIR" WINEARCH="win64" WINEDEBUG="-all" \
        "$WINE_BIN" wineboot --init 2>&1 | tee -a "$LOGFILE" | tail -5
    # Set Windows 10 in registry
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG="-all" \
        "$WINE_BIN" reg add \
        "HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion" \
        /v CurrentVersion /t REG_SZ /d "10.0" /f 2>/dev/null || true
    ok "Prefix '$PREFIX_NAME' created"
fi

# ── MoltenVK / Vulkan ICD ────────────────────────────────────────────────────
# On macOS, DXVK needs Vulkan which needs MoltenVK.
# If VK_ICD_FILENAMES is already set (from config.env), use it.
# Otherwise try to find it via common Homebrew paths.
if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
    for p in \
        "/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json" \
        "/opt/homebrew/share/vulkan/icd.d/MoltenVK_icd.json" \
        "/usr/local/etc/vulkan/icd.d/MoltenVK_icd.json" \
        "/usr/local/share/vulkan/icd.d/MoltenVK_icd.json"; do
        if [[ -f "$p" ]]; then
            export VK_ICD_FILENAMES="$p"
            break
        fi
    done
fi

if [[ -n "${VK_ICD_FILENAMES:-}" && -f "$VK_ICD_FILENAMES" ]]; then
    export VK_ICD_FILENAMES
    info "MoltenVK ICD: $VK_ICD_FILENAMES"
else
    warn "MoltenVK ICD not found – DXVK/Vulkan acceleration unavailable."
    warn "Install via: brew install molten-vk"
fi

# ── build full environment ───────────────────────────────────────────────────
export WINEPREFIX="$PREFIX_DIR"
export WINEARCH="${WINEARCH:-win64}"
export WINEDEBUG="${WINEDEBUG:--all}"
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-warn}"
export DXVK_LOG_PATH="$LOG_DIR"
export MESA_GL_VERSION_OVERRIDE="${MESA_GL_VERSION_OVERRIDE:-4.1}"

# Silence spurious CoreAudio messages on macOS
export COREAUDIO_DEBUG="${COREAUDIO_DEBUG:-0}"

# ── resolve EXE path ─────────────────────────────────────────────────────────
# If EXE is a built-in wine command (e.g. notepad, winecfg, wineboot), pass as-is.
# If it's a real path, expand ~ and verify existence.
WINE_CMD=()
case "$EXE" in
    notepad|winecfg|wineboot|regedit|taskmgr|msiexec|cmd|explorer)
        WINE_CMD=("$WINE_BIN" "$EXE" "${EXTRA_ARGS[@]}")
        ;;
    /*)  # absolute path
        if [[ ! -f "$EXE" ]]; then
            die "EXE not found: $EXE"
        fi
        WINE_CMD=("$WINE_BIN" "$EXE" "${EXTRA_ARGS[@]}")
        ;;
    ~/*) # tilde path
        EXE_EXPANDED="${EXE/#\~/$HOME}"
        if [[ ! -f "$EXE_EXPANDED" ]]; then
            die "EXE not found after tilde expansion: $EXE_EXPANDED"
        fi
        WINE_CMD=("$WINE_BIN" "$EXE_EXPANDED" "${EXTRA_ARGS[@]}")
        ;;
    *)   # relative path or plain command
        WINE_CMD=("$WINE_BIN" "$EXE" "${EXTRA_ARGS[@]}")
        ;;
esac

# ── launch ───────────────────────────────────────────────────────────────────
info "Prefix     : $WINEPREFIX"
info "Command    : ${WINE_CMD[*]}"
info "Log        : $LOGFILE"
info "──────────────────────────────────────────────"

{
    echo "=== winrun log ==="
    echo "Date       : $(date)"
    echo "Prefix     : $WINEPREFIX"
    echo "Wine       : $WINE_BIN  ($WINE_VER)"
    echo "Command    : ${WINE_CMD[*]}"
    echo "VK_ICD     : ${VK_ICD_FILENAMES:-unset}"
    echo "WINEDEBUG  : $WINEDEBUG"
    echo "DXVK_LOG   : $DXVK_LOG_LEVEL"
    echo "=================="
} >> "$LOGFILE"

# Run Wine; capture stderr to log but still show on terminal
"${WINE_CMD[@]}" 2> >(tee -a "$LOGFILE" >&2)
EXIT_CODE=$?

if [[ $EXIT_CODE -eq 0 ]]; then
    ok "Process exited cleanly (code 0)"
else
    warn "Process exited with code $EXIT_CODE  (log: $LOGFILE)"
fi

exit $EXIT_CODE
