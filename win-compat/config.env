#!/usr/bin/env bash
# =============================================================================
# win-compat/config.env
# Central configuration for the Wine/Windows compatibility stack.
# Source this file from any script:  source "$HOME/win-compat/config.env"
# =============================================================================

# --------------- Directory layout ---------------
export WINCOMPAT_ROOT="$HOME/win-compat"
export WINCOMPAT_PREFIXES="$WINCOMPAT_ROOT/prefixes"
export WINCOMPAT_INSTALLERS="$WINCOMPAT_ROOT/installers"
export WINCOMPAT_SCRIPTS="$WINCOMPAT_ROOT/scripts"
export WINCOMPAT_LOGS="$WINCOMPAT_ROOT/logs"

# --------------- Wine binary ---------------
# On Apple Silicon the only free/open-source way to run x86 Windows EXEs is:
#   Option A: Wine (x86_64 build) running under Rosetta 2 on macOS.
#             The x86_64 Wine binary itself is translated by Rosetta 2, which
#             then lets Wine execute 32-/64-bit x86 Windows code.
#   Option B: UTM + Windows ARM ISO + Windows' own x86 emulation layer (slower
#             but more compatible for some titles).
#
# We auto-detect the Wine binary below; override WINE_BIN if needed.
#
# Priority order:
#   1. wine-crossover  (GCenx tap – best macOS ARM support, Apache 2.0 licence)
#   2. wine64          (standard Homebrew formula, x86_64, needs Rosetta 2)
#   3. wine            (fallback)

_detect_wine() {
    local candidates=(
        "/opt/homebrew/bin/wine64"
        "/usr/local/bin/wine64"
        "/opt/homebrew/bin/wine"
        "/usr/local/bin/wine"
    )
    # Also check Cask locations (wine-crossover ships as a .app bundle with helper bins)
    local crossover_paths=(
        "/Applications/Wine Crossover.app/Contents/Resources/wine/bin/wine64"
        "/Applications/Wine Crossover.app/Contents/Resources/wine/bin/wine"
    )
    for p in "${crossover_paths[@]}" "${candidates[@]}"; do
        if [[ -x "$p" ]]; then echo "$p"; return 0; fi
    done
    # Last resort: PATH lookup
    command -v wine64 2>/dev/null || command -v wine 2>/dev/null || echo ""
}

export WINE_BIN="${WINE_BIN:-$(_detect_wine)}"

# The companion server binary (wineserver) must match the wine binary.
export WINESERVER_BIN="${WINESERVER_BIN:-$(dirname "$WINE_BIN")/wineserver}"

# --------------- Rosetta 2 ---------------
# On arm64 macOS, wine (x86_64 binary) MUST run under Rosetta 2.
# We store the arch so scripts can warn if something is wrong.
export HOST_ARCH="$(uname -m)"   # aarch64 on Apple Silicon

# --------------- MoltenVK / Vulkan ---------------
# MoltenVK provides a Vulkan implementation on top of Metal.
# DXVK uses Vulkan → it needs MoltenVK on macOS.
#
# Homebrew installs the ICD JSON at one of these paths:
_detect_moltenvk_icd() {
    local candidates=(
        "/opt/homebrew/etc/vulkan/icd.d/MoltenVK_icd.json"
        "/opt/homebrew/share/vulkan/icd.d/MoltenVK_icd.json"
        "/usr/local/etc/vulkan/icd.d/MoltenVK_icd.json"
        "/usr/local/share/vulkan/icd.d/MoltenVK_icd.json"
        "$HOME/.local/share/vulkan/icd.d/MoltenVK_icd.json"
    )
    for p in "${candidates[@]}"; do
        if [[ -f "$p" ]]; then echo "$p"; return 0; fi
    done
    echo ""
}
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-$(_detect_moltenvk_icd)}"

# --------------- DXVK ---------------
# DXVK translates Direct3D 9/10/11 calls to Vulkan.
# Set DXVK_LOG_LEVEL=none to silence; use "info" or "debug" to troubleshoot.
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-warn}"
# DXVK 2.x requires Vulkan 1.3; MoltenVK 1.2.x only provides Vulkan 1.2.
# Use 1.10.3 (last version that works with Vulkan 1.1+) unless overridden.
# NOTE: AoE2 HD uses wined3d (not DXVK) — see launch-aoe2-goldberg.sh.
export DXVK_VERSION="${DXVK_VERSION:-1.10.3}"

# --------------- Wine runtime knobs ---------------
export WINEDEBUG="${WINEDEBUG:--all}"          # suppress most debug spam; set "+d3d11" etc to debug
export WINEARCH="${WINEARCH:-win64}"
export MESA_GL_VERSION_OVERRIDE="${MESA_GL_VERSION_OVERRIDE:-4.1}"

# macOS-specific: hide the Dock icon for Wine processes
export WINE_HIDE_CRASHDIALOG="${WINE_HIDE_CRASHDIALOG:-1}"
